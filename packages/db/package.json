{
  "name": "@nava/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "generate": "dotenv -c -e ../../.env.example -- prisma generate",
    "validate": "dotenv -c -e ../../.env.example -- prisma validate",
    "migrate:diff": "dotenv -c -e ../../.env.example -- prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:check": "dotenv -c -e ../../apps/web/.env.local -e ../../.env.local -e ../../.env -e ../../.env.example -- node scripts/check-db.ts",
    "db:migrate:deploy": "dotenv -c -e ../../apps/web/.env.local -e ../../.env.local -e ../../.env -- prisma migrate deploy",
    "db:migrate:status": "dotenv -c -e ../../apps/web/.env.local -e ../../.env.local -e ../../.env -- prisma migrate status"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@nava/config": "workspace:*",
    "@types/node": "^22.10.1",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  }
}
