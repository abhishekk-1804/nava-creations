# ==============================================================================
# NAVA CREATIONS — Environment Variables Template (Sprint 2K Clean Baseline)
# ==============================================================================
# Strictly for local and deployment reference. Never commit real credentials!
# Copy this file to .env.local for local development.
# ==============================================================================

# Application Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="false"

# Database Connections (PostgreSQL 16)
# Local Prototype connection:
# DATABASE_URL="postgresql://nava_app:3b2133a8b9865153e6060e2506b751c5b681821a801acc69e0924c419343b2ba@127.0.0.1:5432/nava_prototype_dev?schema=public"
#
# Production / Neon Managed PostgreSQL:
# Connection pooled URL for runtime queries (Prisma client)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&pgbouncer=true"
# Direct URL for migrations and schema introspection (Prisma CLI)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Upstash Redis (Edge Rate Limiting & Ephemeral Cache)
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="placeholder_upstash_token_here"

# Inngest Background Worker (Deferred / Optional)
INNGEST_EVENT_KEY="placeholder_inngest_event_key"
INNGEST_SIGNING_KEY="placeholder_inngest_signing_key"

# Sovereign India-First Payments (Zero-MDR BharatPe UPI QR & Cash on Delivery)
# Merchant UPI Virtual Payment Address (Must be officially provisioned by store owner)
MERCHANT_UPI_VPA=""
# Legal Merchant Display Name
MERCHANT_DISPLAY_NAME="NAVA CREATIONS"
# Static or Dynamic QR image asset path
MERCHANT_QR_IMAGE_URL="/branding/merchant-upi-qr.png"
# Explicit merchant bank onboarding confirmation flag (true only after acquiring approval)
MERCHANT_ONBOARDING_APPROVED="false"
# Cash on Delivery (COD) configuration (Disabled until formal owner policy approval)
COD_ENABLED="false"
# Maximum allowed order value for COD in paise (e.g. 500000 = ₹5,000 provisional ceiling)
COD_MAX_PAISE="500000"
# Owner COD policy ratification flag (true only after formal business-owner sign-off)
COD_POLICY_APPROVED="false"
# Optional COD handling surcharge in paise (e.g. 0 or 5000 = ₹50)
COD_COURIER_CHARGE_PAISE="0"

# Studio & Customer Contact Channels
# Primary WhatsApp Concierge (e.g. "917204628513" / "+91 72046 28513")
NEXT_PUBLIC_BUSINESS_WHATSAPP_NUMBER="917204628513"
NEXT_PUBLIC_BUSINESS_WHATSAPP_DISPLAY="+91 72046 28513"
# Secondary Studio / Bridal Desk Consultation (e.g. "916361200493" / "+91 63612 00493")
NEXT_PUBLIC_STUDIO_PHONE_NUMBER="916361200493"
NEXT_PUBLIC_STUDIO_PHONE_DISPLAY="+91 63612 00493"
NEXT_PUBLIC_INSTAGRAM_HANDLE="nava__creationsss"
STUDIO_NOTIFICATION_EMAIL="orders@navacreations.in"

# Logistics (Shiprocket)
SHIPROCKET_API_EMAIL="logistics@placeholder.com"
SHIPROCKET_API_PASSWORD="placeholder_shiprocket_password"

# Transactional Email (Resend)
RESEND_API_KEY="re_placeholder_apiKey123"
EMAIL_FROM="orders@placeholder.com"

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME="nava-creations-placeholder"
CLOUDINARY_API_KEY="placeholder_cloudinary_api_key"
CLOUDINARY_API_SECRET="placeholder_cloudinary_api_secret"

# Authentication & Session Security
# Generate with: openssl rand -base64 32 (minimum 32 characters required)
ADMIN_AUTH_SECRET="placeholder_minimum_32_character_cryptographic_secret"
CUSTOMER_AUTH_SECRET="placeholder_minimum_32_character_customer_secret"
SESSION_COOKIE_NAME="nava_admin_session"
CUSTOMER_COOKIE_NAME="nava_customer_session"
CRON_SECRET="placeholder_minimum_32_character_cron_secret"

# Reverse Proxy & Client IP Trust Configuration
# Set to "true" ONLY when deployed behind a verified reverse proxy (Cloudflare, AWS ALB, Nginx, Vercel)
# that sanitizes/strips incoming forwarding headers. In direct deployments, leave "false".
TRUST_PROXY="false"
# Reverse proxy provider profile: "standard" (Nginx / ALB / Vercel) or "cloudflare" (CF-Connecting-IP)
PROXY_PROVIDER="standard"

# Commercial & Tax Configuration
# Options: UNREGISTERED | COMPOSITION_SCHEME | REGULAR_GST_REGISTERED
DEFAULT_STORE_TAX_MODE="UNREGISTERED"
ORIGIN_STATE_CODE="29" # Karnataka
